[Unit]
Description=SiriusVision Spotify now-playing poller
After=network.target

[Service]
Type=simple
User=darren
WorkingDirectory=/home/darren/tuneshare
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/siriusvision/spotify.env
RuntimeDirectory=siriusvision-spotify
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=yes
ExecStart=/home/darren/tuneshare/.venv/bin/python -m siriusvision.spotify watch --config /home/darren/tuneshare/config.json
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
