[Unit]
Description=SiriusVision LED matrix display
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/darren/tuneshare
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/darren/tuneshare/.venv/bin/python -m siriusvision --display pi --config /home/darren/tuneshare/config.json
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
